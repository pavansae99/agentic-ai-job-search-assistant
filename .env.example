APP_NAME=Agentic AI Job Search Assistant
APP_VERSION=0.1.0
ENVIRONMENT=development
LOG_LEVEL=INFO
API_PREFIX=/api
DATABASE_URL=sqlite:///./job_search.db

# LLM_PROVIDER supports auto, mock, or openai. Auto uses OpenAI only when a key is present.
LLM_PROVIDER=auto
# OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini
OPENAI_TIMEOUT_SECONDS=30
OPENAI_MAX_RETRIES=2
# Reserved for future end-to-end cancellation; not enforced in Phase 1.
# LLM_WORKFLOW_DEADLINE_SECONDS=90

# LANGSMITH_API_KEY=
